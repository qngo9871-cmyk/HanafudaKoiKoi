"yaku.threeBrights.desc" = "Capture any 3 bright cards, not including Rain Man.";
"yaku.animals.desc" = "Capture 5 or more animal cards. Each card beyond 5 adds another point.";
"yaku.boarDeerButterfly.desc" = "Capture the Boar, Deer, and Butterflies animal cards together.";
"yaku.ribbons.desc" = "Capture 5 or more ribbon cards of any color. Each card beyond 5 adds another point.";
