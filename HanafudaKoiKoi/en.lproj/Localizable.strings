"yaku.blueRibbons.desc" = "Capture all 3 blue ribbons (June, September, October).";
"yaku.poetryBlueCombo.desc" = "Capture both full ribbon sets above in the same hand for a large bonus.";
"yaku.chaff.desc" = "Capture 10 or more plain (chaff) cards. Each card beyond 10 adds another point.";
"yaku.moonViewing.desc" = "Capture the Moon (August bright) together with the Sake Cup (September animal).";
"yaku.flowerViewing.desc" = "Capture the Curtain (March bright) together with the Sake Cup (September animal).";

